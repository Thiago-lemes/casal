DB_USER=casal
DB_PASSWORD=troque-esta-senha
DB_NAME=casal
# o app usa o papel limitado (casal_app); as migrações usam o dono
APP_DB_PASSWORD=outra-senha-forte
# papel só de leitura das views de agregados (schema ops) que o Grafana usa; não lê nenhuma tabela de negócio
OPS_DB_PASSWORD=mais-uma-senha-forte
DATABASE_URL=postgres://casal_app:outra-senha-forte@localhost:5432/casal?sslmode=disable
MIGRATE_DATABASE_URL=postgres://casal:troque-esta-senha@localhost:5432/casal?sslmode=disable

HTTP_ADDR=:8080
# true (padrão) em produção, atrás de HTTPS; false só no desenvolvimento local
COOKIE_SECURE=false
# true apenas se o servidor estiver atrás de um proxy seu (usa o X-Forwarded-For para limitar tentativas)
TRUST_PROXY=false
SESSION_TTL_HOURS=720
# open (padrão): qualquer pessoa cria conta. invite (beta): exige um código; crie com: go run ./cmd/admin signup-code create
SIGNUP_MODE=open
# painel de suporte em /admin/v1 (desligado por padrão). Crie as contas com: go run ./cmd/admin admin create voce@email.com
ADMIN_ENABLED=false

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# --- observabilidade (opcional; sem valor, o recurso fica desligado) ---
# relatório de erros SEM conteúdo (Sentry ou GlitchTip)
SENTRY_DSN=
APP_ENV=beta
APP_RELEASE=
# /metrics em formato Prometheus: ou num endereço interno separado, ou na porta principal com token (Bearer)
METRICS_ADDR=
METRICS_TOKEN=
