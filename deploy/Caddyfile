{$SITE_ADDRESS} {
	encode gzip

	# a API: mesma origem do frontend, então o cookie de sessão não precisa de CORS
	@api path /v1/* /healthz
	reverse_proxy @api api:8080

	# o service worker nunca pode ficar em cache, senão as atualizações do PWA não chegam
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	# SPA: qualquer rota desconhecida cai no index.html
	root * /srv
	try_files {path} /index.html
	file_server
}
