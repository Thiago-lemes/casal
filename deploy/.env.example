# copie para deploy/.env no servidor e troque TODAS as senhas (openssl rand -hex 24)
DB_USER=casal
DB_PASSWORD=troque
DB_NAME=casal
APP_DB_PASSWORD=troque-outra
# usado pelo Grafana para ler só as views de agregados (schema ops)
OPS_DB_PASSWORD=troque-mais-uma

# sem domínio: use o IP elástico com pontos trocados por hífens + .sslip.io (ex.: 3-90-12-34.sslip.io)
SITE_ADDRESS=3-90-12-34.sslip.io

SESSION_TTL_HOURS=720
# gere com: docker compose run --rm --entrypoint vapid api
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com

# observabilidade (opcional): deixe em branco para desligar
SENTRY_DSN=
APP_RELEASE=
# token para o Grafana/Prometheus ler o /metrics (openssl rand -hex 24); sem ele a rota não existe
METRICS_TOKEN=
